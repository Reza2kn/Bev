diff --git a/tools/server/server-schema.cpp b/tools/server/server-schema.cpp
index 64b9251..228864e 100644
--- a/tools/server/server-schema.cpp
+++ b/tools/server/server-schema.cpp
@@ -190,6 +190,32 @@ std::vector<std::unique_ptr<field>> make_llama_cmpl_schema(const common_params &
     add((new field_bool("post_sampling_probs", params.post_sampling_probs))
         ->set_desc("Return probabilities of top n_probs tokens after applying the sampling chain"));
 
+    add((new field_json("selected_token_ids"))
+        ->set_desc("Bev: return full-vocabulary pre-sampling logprobs for these token IDs in request order")
+        ->set_handler([](field_eval_context & ctx, const json & data) {
+            const auto & ids = data.at("selected_token_ids");
+            if (!ids.is_array() || ids.empty() || ids.size() > 4096) {
+                throw std::invalid_argument("selected_token_ids must be a nonempty array of at most 4096 unique token IDs");
+            }
+            if (ctx.params.post_sampling_probs) {
+                throw std::invalid_argument("selected_token_ids requires post_sampling_probs=false");
+            }
+            const int64_t n_vocab = llama_vocab_n_tokens(ctx.vocab);
+            std::unordered_set<llama_token> seen;
+            for (const auto & value : ids) {
+                if (!value.is_number_integer()) {
+                    throw std::invalid_argument("selected_token_ids entries must be integers");
+                }
+                const int64_t id = value.get<int64_t>();
+                if (id < 0 || id >= n_vocab || !seen.insert(static_cast<llama_token>(id)).second) {
+                    throw std::invalid_argument("selected_token_ids entries must be unique and within vocabulary bounds");
+                }
+                ctx.params.selected_token_ids.push_back(static_cast<llama_token>(id));
+            }
+            // Existing pre-sampling path disables backend sampling and carries results.
+            ctx.params.sampling.n_probs = static_cast<int32_t>(ids.size());
+        }));
+
     //
     // Speculative decoding params
     //
