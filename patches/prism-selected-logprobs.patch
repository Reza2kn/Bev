     void populate_token_probs(const server_slot & slot, completion_token_output & result, bool post_sampling, bool special, int idx) const {
         const size_t n_probs_request = slot.task->params.sampling.n_probs;
 
+        const auto & selected_ids = slot.task->params.selected_token_ids;
+        if (!selected_ids.empty()) {
+            // n_top=0 retains full-vocabulary softmax without sorting or serializing
+            // the entire vocabulary. Never apply a candidate-only normalization.
+            const auto cur = get_token_probabilities(ctx_tgt, idx, 0);
+            std::vector<float> probabilities(llama_vocab_n_tokens(vocab), -1.0f);
+            for (const auto & token : cur) {
+                GGML_ASSERT(token.id >= 0 && static_cast<size_t>(token.id) < probabilities.size());
+                probabilities[token.id] = token.p;
+                if (token.id == result.tok) {
+                    result.prob = token.p;
+                }
+            }
+            result.probs.reserve(selected_ids.size());
+            for (const auto id : selected_ids) {
+                GGML_ASSERT(probabilities[id] >= 0.0f); // validated IDs + pre-sampling logits
+                result.probs.push_back({id, common_token_to_piece(ctx_tgt, id, special), probabilities[id]});
+            }
+            return;
+        }
+
         if (post_sampling) {
             const auto * cur_p = common_sampler_get_candidates(slot.smpl.get(), true);
             const size_t max_probs = cur_p->size;
